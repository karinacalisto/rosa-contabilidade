# ===== AWS Configuration =====
# Para produção, configure via variáveis de ambiente ou IAM Role no Elastic Beanstalk
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# ===== DynamoDB =====
# Deixe vazio para usar AWS real. Para dev local, use http://localhost:8000
AWS__DynamoDbServiceUrl=

# ===== S3 =====
AWS__S3BucketName=rosa-contabilidade-docs
# Para dev local com LocalStack: http://localhost:4566
AWS__S3ServiceUrl=

# ===== JWT =====
Jwt__Key=RosaContabilidadeSuperSecretKeyQueDeveSerTrocadaEmProducao2024!
Jwt__Issuer=RosaContabilidade
Jwt__Audience=RosaContabilidadeClients
Jwt__ExpireMinutes=60

# ===== CORS =====
# Separados por vírgula se configurar via env var
Cors__AllowedOrigins__0=http://localhost:4200
Cors__AllowedOrigins__1=https://www.rosacontabilidade.com.br
