# ===== Rosa Contabilidade - Variáveis de Ambiente =====
# Copie este arquivo para .env e ajuste os valores

# Banco de dados MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rosa_contabilidade
MYSQL_USER=root
MYSQL_PASSWORD=root

# Connection string completa (alternativa)
# ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=rosa_contabilidade;User=root;Password=root;

# JWT
JWT_KEY=RosaContabilidadeSuperSecretKeyQueDeveSerTrocadaEmProducao2024!
JWT_ISSUER=RosaContabilidade
JWT_AUDIENCE=RosaContabilidadeClients
JWT_EXPIRE_MINUTES=60

# CORS - origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000

# Uploads - pasta para armazenar documentos
# Em dev, usa pasta padrão dentro do projeto
# Em produção, configurar caminho absoluto ex: C:\inetpub\wwwroot\rosa-contabilidade\App_Data\uploads
UPLOADS_PATH=

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
